#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
remote="${1:-}"
if [[ "$remote" != fork ]]; then
    echo "FAIL: push only to the public fork remote, not upstream" >&2
    exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/feature/*|refs/heads/fix/*)
            ;;
        refs/tags/*)
            ;;
        *)
            echo "FAIL: push only feature/fix branches or tags" >&2
            exit 1
            ;;
    esac
done
"$root/scripts/preflight-mps.sh" --committed

# Git supplies ref updates through stdin. Read confirmation from the
# controlling terminal so it cannot be confused with those updates.
if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
    echo "FAIL: interactive PUBLISH confirmation required" >&2
    exit 1
fi

printf '\nPublication checks passed. Review commits before pushing.\n\nThis push may expose code and history publicly. Type PUBLISH: ' > /dev/tty

if ! IFS= read -r confirmation < /dev/tty; then
    echo "FAIL: confirmation could not be read" >&2
    exit 1
fi

if [[ "$confirmation" != "PUBLISH" ]]; then
    echo "Push cancelled." >&2
    exit 1
fi

echo "PASS: PUBLISH confirmation accepted"
